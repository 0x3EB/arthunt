{
  "version": "1.0.0",
  "rules": [
    {
      "id": "private-key",
      "name": "Private Key (PEM)",
      "severity": "critical",
      "category": "key",
      "regex": "-----BEGIN[ A-Z0-9]*PRIVATE KEY-----",
      "keywords": [
        "private key"
      ],
      "entropy_min": 0,
      "description": "PEM-encoded private key (RSA/EC/DSA/OpenSSH/PGP)."
    },
    {
      "id": "putty-private-key",
      "name": "PuTTY Private Key",
      "severity": "critical",
      "category": "key",
      "regex": "PuTTY-User-Key-File-[0-9]",
      "keywords": [
        "putty-user-key-file"
      ],
      "entropy_min": 0,
      "description": "PuTTY .ppk private key file."
    },
    {
      "id": "aws-access-key-id",
      "name": "AWS Access Key ID",
      "severity": "high",
      "category": "cloud",
      "regex": "\\b((?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA|AGPA|AIDA|AIPA|ANPA|ANVA|AROA|APKA)[A-Z0-9]{16})\\b",
      "keywords": [
        "akia",
        "asia",
        "abia",
        "acca",
        "agpa",
        "aida",
        "aipa",
        "anpa",
        "anva",
        "aroa",
        "apka",
        "a3t"
      ],
      "entropy_min": 0,
      "description": "AWS access key identifier."
    },
    {
      "id": "aws-secret-access-key",
      "name": "AWS Secret Access Key",
      "severity": "critical",
      "category": "cloud",
      "regex": "(?i)aws.{0,20}?(?:secret|sak|key).{0,3}[:=]\\s*[\"']?([A-Za-z0-9/+=]{40})[\"']?",
      "keywords": [
        "aws"
      ],
      "entropy_min": 4.2,
      "description": "AWS secret access key in context."
    },
    {
      "id": "aws-session-token",
      "name": "AWS Session Token",
      "severity": "high",
      "category": "cloud",
      "regex": "(?i)aws_session_token[\"']?\\s*[:=]\\s*[\"']?([A-Za-z0-9/+=]{100,})",
      "keywords": [
        "aws_session_token"
      ],
      "entropy_min": 4,
      "description": "AWS temporary session token."
    },
    {
      "id": "gcp-api-key",
      "name": "Google API Key",
      "severity": "high",
      "category": "cloud",
      "regex": "\\b(AIza[0-9A-Za-z\\-_]{35})\\b",
      "keywords": [
        "aiza"
      ],
      "entropy_min": 0,
      "description": "Google Cloud / Maps / Firebase API key."
    },
    {
      "id": "gcp-oauth",
      "name": "Google OAuth Access Token",
      "severity": "high",
      "category": "cloud",
      "regex": "\\b(ya29\\.[0-9A-Za-z\\-_]{20,})\\b",
      "keywords": [
        "ya29."
      ],
      "entropy_min": 0,
      "description": "Google OAuth2 access token."
    },
    {
      "id": "gcp-service-account",
      "name": "GCP Service Account JSON",
      "severity": "critical",
      "category": "cloud",
      "regex": "\"type\"\\s*:\\s*\"service_account\"",
      "keywords": [
        "service_account"
      ],
      "entropy_min": 0,
      "description": "Google service-account credential JSON."
    },
    {
      "id": "azure-storage-key",
      "name": "Azure Storage AccountKey",
      "severity": "critical",
      "category": "cloud",
      "regex": "AccountKey\\s*=\\s*([A-Za-z0-9+/=]{86,88})",
      "keywords": [
        "accountkey"
      ],
      "entropy_min": 4,
      "description": "Azure storage account key in connection string."
    },
    {
      "id": "azure-sas",
      "name": "Azure SAS Token",
      "severity": "high",
      "category": "cloud",
      "regex": "sig=([A-Za-z0-9%]{43,53})%3[Dd]",
      "keywords": [
        "sig="
      ],
      "entropy_min": 3.5,
      "description": "Azure Shared Access Signature."
    },
    {
      "id": "azure-client-secret",
      "name": "Azure AD Client Secret",
      "severity": "high",
      "category": "cloud",
      "regex": "\\b([0-9A-Za-z~._\\-]{3}8Q~[0-9A-Za-z~._\\-]{34})\\b",
      "keywords": [
        "8q~"
      ],
      "entropy_min": 3.5,
      "description": "Azure AD application client secret."
    },
    {
      "id": "github-pat",
      "name": "GitHub Personal Access Token",
      "severity": "high",
      "category": "vcs",
      "regex": "\\b((?:ghp|gho|ghu|ghs|ghr)_[0-9A-Za-z]{36})\\b",
      "keywords": [
        "ghp_",
        "gho_",
        "ghu_",
        "ghs_",
        "ghr_"
      ],
      "entropy_min": 0,
      "description": "GitHub token (classic / app / refresh)."
    },
    {
      "id": "github-fine-grained",
      "name": "GitHub Fine-Grained PAT",
      "severity": "high",
      "category": "vcs",
      "regex": "\\b(github_pat_[0-9A-Za-z_]{82})\\b",
      "keywords": [
        "github_pat_"
      ],
      "entropy_min": 0,
      "description": "GitHub fine-grained personal access token."
    },
    {
      "id": "gitlab-pat",
      "name": "GitLab Personal Access Token",
      "severity": "high",
      "category": "vcs",
      "regex": "\\b(glpat-[0-9A-Za-z\\-_]{20,})\\b",
      "keywords": [
        "glpat-"
      ],
      "entropy_min": 0,
      "description": "GitLab personal/project access token."
    },
    {
      "id": "gitlab-pipeline",
      "name": "GitLab Pipeline/Runner Token",
      "severity": "high",
      "category": "vcs",
      "regex": "\\b(glptt-[0-9a-f]{40}|GR1348941[0-9A-Za-z\\-_]{20})\\b",
      "keywords": [
        "glptt-",
        "gr1348941"
      ],
      "entropy_min": 0,
      "description": "GitLab pipeline trigger or runner registration token."
    },
    {
      "id": "github-oauth-app",
      "name": "GitHub App / OAuth client secret",
      "severity": "medium",
      "category": "vcs",
      "regex": "(?i)github.{0,20}(?:secret|token).{0,3}[:=]\\s*[\"']?([0-9a-f]{40})[\"']?",
      "keywords": [
        "github"
      ],
      "entropy_min": 3,
      "description": "GitHub OAuth app client secret (40 hex)."
    },
    {
      "id": "slack-token",
      "name": "Slack Token",
      "severity": "high",
      "category": "saas",
      "regex": "\\b(xox[baprs]-[0-9A-Za-z-]{10,72})\\b",
      "keywords": [
        "xoxb-",
        "xoxa-",
        "xoxp-",
        "xoxr-",
        "xoxs-"
      ],
      "entropy_min": 0,
      "description": "Slack API token."
    },
    {
      "id": "slack-webhook",
      "name": "Slack Webhook URL",
      "severity": "medium",
      "category": "saas",
      "regex": "https://hooks\\.slack\\.com/services/T[0-9A-Za-z_]+/B[0-9A-Za-z_]+/[0-9A-Za-z]{20,}",
      "keywords": [
        "hooks.slack.com"
      ],
      "entropy_min": 0,
      "description": "Slack incoming webhook URL."
    },
    {
      "id": "stripe-secret",
      "name": "Stripe Secret Key",
      "severity": "critical",
      "category": "saas",
      "regex": "\\b((?:sk|rk)_(?:live|test)_[0-9A-Za-z]{24,99})\\b",
      "keywords": [
        "sk_live_",
        "sk_test_",
        "rk_live_",
        "rk_test_"
      ],
      "entropy_min": 0,
      "description": "Stripe secret / restricted API key."
    },
    {
      "id": "sendgrid",
      "name": "SendGrid API Key",
      "severity": "high",
      "category": "saas",
      "regex": "\\b(SG\\.[0-9A-Za-z\\-_]{22}\\.[0-9A-Za-z\\-_]{43})\\b",
      "keywords": [
        "sg."
      ],
      "entropy_min": 0,
      "description": "SendGrid API key."
    },
    {
      "id": "twilio-sid",
      "name": "Twilio API credential",
      "severity": "medium",
      "category": "saas",
      "regex": "(?i)twilio.{0,40}?\\b((?:AC|SK)[0-9a-f]{32})\\b",
      "keywords": [
        "twilio"
      ],
      "entropy_min": 3,
      "description": "Twilio account/API SID near a 'twilio' reference."
    },
    {
      "id": "mailgun",
      "name": "Mailgun API Key",
      "severity": "high",
      "category": "saas",
      "regex": "(?i)mailgun.{0,40}?\\b(key-[0-9a-zA-Z]{32})\\b",
      "keywords": [
        "mailgun"
      ],
      "entropy_min": 3,
      "description": "Mailgun API key near a 'mailgun' reference."
    },
    {
      "id": "mailchimp",
      "name": "Mailchimp API Key",
      "severity": "high",
      "category": "saas",
      "regex": "\\b([0-9a-f]{32}-us[0-9]{1,2})\\b",
      "keywords": [
        "-us"
      ],
      "entropy_min": 3,
      "description": "Mailchimp API key."
    },
    {
      "id": "square-token",
      "name": "Square Access Token",
      "severity": "high",
      "category": "saas",
      "regex": "\\b((?:sq0atp-|sq0csp-)[0-9A-Za-z\\-_]{22,43}|EAAA[0-9A-Za-z\\-_]{60})\\b",
      "keywords": [
        "sq0atp-",
        "sq0csp-",
        "eaaa"
      ],
      "entropy_min": 0,
      "description": "Square OAuth / access token."
    },
    {
      "id": "shopify-token",
      "name": "Shopify Token",
      "severity": "high",
      "category": "saas",
      "regex": "\\b(shp(?:at|ca|pa|ss)_[0-9a-fA-F]{32})\\b",
      "keywords": [
        "shpat_",
        "shpca_",
        "shppa_",
        "shpss_"
      ],
      "entropy_min": 0,
      "description": "Shopify access / custom-app / private-app token."
    },
    {
      "id": "digitalocean",
      "name": "DigitalOcean Token",
      "severity": "high",
      "category": "cloud",
      "regex": "\\b(do[opr]_v1_[0-9a-f]{64})\\b",
      "keywords": [
        "dop_v1_",
        "doo_v1_",
        "dor_v1_"
      ],
      "entropy_min": 0,
      "description": "DigitalOcean personal/OAuth/refresh token."
    },
    {
      "id": "openai",
      "name": "OpenAI API Key (legacy)",
      "severity": "high",
      "category": "ai",
      "regex": "\\b(sk-(?:proj-)?[0-9A-Za-z\\-_]{20}T3BlbkFJ[0-9A-Za-z\\-_]{20,})\\b",
      "keywords": [
        "t3blbkfj"
      ],
      "entropy_min": 0,
      "description": "OpenAI API key (legacy T3BlbkFJ format)."
    },
    {
      "id": "openai-project",
      "name": "OpenAI Project/Service Key",
      "severity": "high",
      "category": "ai",
      "regex": "\\b(sk-(?:proj|svcacct|admin)-[0-9A-Za-z_\\-]{40,})\\b",
      "keywords": [
        "sk-proj-",
        "sk-svcacct-",
        "sk-admin-"
      ],
      "entropy_min": 3.5,
      "description": "OpenAI project/service-account/admin API key."
    },
    {
      "id": "anthropic",
      "name": "Anthropic API Key",
      "severity": "high",
      "category": "ai",
      "regex": "\\b(sk-ant-[0-9A-Za-z\\-_]{20,})\\b",
      "keywords": [
        "sk-ant-"
      ],
      "entropy_min": 0,
      "description": "Anthropic API key."
    },
    {
      "id": "huggingface",
      "name": "Hugging Face Token",
      "severity": "high",
      "category": "ai",
      "regex": "\\b(hf_[0-9A-Za-z]{34})\\b",
      "keywords": [
        "hf_"
      ],
      "entropy_min": 0,
      "description": "Hugging Face access token."
    },
    {
      "id": "telegram-bot",
      "name": "Telegram Bot Token",
      "severity": "medium",
      "category": "saas",
      "regex": "\\b([0-9]{8,10}:AA[0-9A-Za-z\\-_]{33})\\b",
      "keywords": [
        ":aa"
      ],
      "entropy_min": 0,
      "description": "Telegram bot API token."
    },
    {
      "id": "discord-bot",
      "name": "Discord Bot Token",
      "severity": "high",
      "category": "saas",
      "regex": "\\b([MNO][A-Za-z0-9\\-_]{23}\\.[A-Za-z0-9\\-_]{6}\\.[A-Za-z0-9\\-_]{27,38})\\b",
      "keywords": [
        "discord"
      ],
      "entropy_min": 4,
      "description": "Discord bot token (near a 'discord' reference)."
    },
    {
      "id": "discord-webhook",
      "name": "Discord Webhook",
      "severity": "medium",
      "category": "saas",
      "regex": "https://(?:ptb\\.|canary\\.)?discord(?:app)?\\.com/api/webhooks/[0-9]{17,20}/[0-9A-Za-z\\-_]{60,}",
      "keywords": [
        "discord",
        "webhooks"
      ],
      "entropy_min": 0,
      "description": "Discord webhook URL."
    },
    {
      "id": "datadog",
      "name": "Datadog API Key",
      "severity": "medium",
      "category": "saas",
      "regex": "(?i)(?:datadog|dd)[._-]?api[._-]?key[\"']?\\s*[:=]\\s*[\"']?([0-9a-f]{32})",
      "keywords": [
        "datadog",
        "dd_api",
        "dd-api"
      ],
      "entropy_min": 3,
      "description": "Datadog API key."
    },
    {
      "id": "pagerduty",
      "name": "PagerDuty Token",
      "severity": "medium",
      "category": "saas",
      "regex": "(?i)pagerduty.{0,40}?(?:token|api[_\\-]?key)[\"']?\\s*[:=]\\s*[\"']?([0-9a-zA-Z+_\\-]{20})",
      "keywords": [
        "pagerduty"
      ],
      "entropy_min": 3.5,
      "description": "PagerDuty API token near a 'pagerduty' reference."
    },
    {
      "id": "jenkins-token",
      "name": "Jenkins API Token",
      "severity": "medium",
      "category": "ci",
      "regex": "(?i)jenkins.{0,20}(?:token|api).{0,3}[:=]\\s*[\"']?([0-9a-f]{32,34})",
      "keywords": [
        "jenkins"
      ],
      "entropy_min": 3,
      "description": "Jenkins API token (contextual)."
    },
    {
      "id": "npm-token",
      "name": "npm Access Token",
      "severity": "high",
      "category": "registry",
      "regex": "\\b(npm_[0-9A-Za-z]{36})\\b",
      "keywords": [
        "npm_"
      ],
      "entropy_min": 0,
      "description": "npm automation/publish token."
    },
    {
      "id": "npmrc-authtoken",
      "name": ".npmrc _authToken",
      "severity": "high",
      "category": "registry",
      "regex": "(?i)_authToken\\s*=\\s*([0-9A-Za-z\\-_=.]{16,})",
      "keywords": [
        "_authtoken"
      ],
      "entropy_min": 0,
      "description": "npm registry auth token in .npmrc."
    },
    {
      "id": "npmrc-auth-basic",
      "name": ".npmrc _auth (base64)",
      "severity": "high",
      "category": "registry",
      "regex": "(?i)(?:^|[^a-z])_auth\\s*=\\s*([A-Za-z0-9+/]{16,}={0,2})",
      "keywords": [
        "_auth"
      ],
      "entropy_min": 3.5,
      "description": "Base64 basic-auth blob in .npmrc."
    },
    {
      "id": "pypi-token",
      "name": "PyPI Upload Token",
      "severity": "high",
      "category": "registry",
      "regex": "\\b(pypi-AgEIcHlwaS5vcmc[0-9A-Za-z\\-_]{50,})\\b",
      "keywords": [
        "pypi-ageichlwas5vcmc"
      ],
      "entropy_min": 0,
      "description": "PyPI API upload token."
    },
    {
      "id": "nuget-apikey",
      "name": "NuGet API Key",
      "severity": "high",
      "category": "registry",
      "regex": "\\b(oy2[a-z0-9]{43})\\b",
      "keywords": [
        "oy2"
      ],
      "entropy_min": 3.5,
      "description": "NuGet.org API key."
    },
    {
      "id": "artifactory-apikey",
      "name": "JFrog Artifactory API Key",
      "severity": "high",
      "category": "registry",
      "regex": "\\b(AKCp[0-9A-Za-z]{60,80})\\b",
      "keywords": [
        "akcp"
      ],
      "entropy_min": 0,
      "description": "JFrog Artifactory API key."
    },
    {
      "id": "artifactory-ref-token",
      "name": "JFrog Reference Token",
      "severity": "high",
      "category": "registry",
      "regex": "\\b(cmVmdGtuOjAxOj[0-9A-Za-z]{40,})\\b",
      "keywords": [
        "cmvmdgtuoja"
      ],
      "entropy_min": 0,
      "description": "JFrog reference token (base64 'reftkn:01:')."
    },
    {
      "id": "docker-auth",
      "name": "Docker config.json auth",
      "severity": "high",
      "category": "registry",
      "regex": "\"auth\"\\s*:\\s*\"([A-Za-z0-9+/]{16,}={0,2})\"",
      "keywords": [
        "\"auth\""
      ],
      "entropy_min": 3.5,
      "description": "Base64 registry credential in Docker config.json."
    },
    {
      "id": "dockercfg",
      "name": ".dockercfg credential",
      "severity": "high",
      "category": "registry",
      "regex": "(?i)\"(?:auth|password)\"\\s*:\\s*\"([^\"]{8,})\"",
      "keywords": [
        "dockercfg",
        "\"password\""
      ],
      "entropy_min": 3,
      "description": "Credential in legacy .dockercfg."
    },
    {
      "id": "jwt",
      "name": "JSON Web Token",
      "severity": "medium",
      "category": "token",
      "regex": "\\b(eyJ[A-Za-z0-9\\-_=]{10,}\\.eyJ[A-Za-z0-9\\-_=]{10,}\\.[A-Za-z0-9\\-_.+/=]{10,})\\b",
      "keywords": [
        "eyj"
      ],
      "entropy_min": 3.8,
      "description": "JWT (may carry credentials/claims)."
    },
    {
      "id": "basic-auth-url",
      "name": "Credentials in URL",
      "severity": "high",
      "category": "generic",
      "regex": "(?i)[a-z][a-z0-9+.\\-]*://[^/\\s:@]{2,}:([^/\\s:@]{3,})@[^/\\s:@]+",
      "keywords": [
        "://"
      ],
      "entropy_min": 0,
      "description": "Inline username:password@ in a URL."
    },
    {
      "id": "db-conn-mongodb",
      "name": "MongoDB URI password",
      "severity": "high",
      "category": "database",
      "regex": "(?i)mongodb(?:\\+srv)?://[^/\\s:@]+:([^/\\s:@]{3,})@",
      "keywords": [
        "mongodb"
      ],
      "entropy_min": 0,
      "description": "Password in a MongoDB connection URI."
    },
    {
      "id": "db-conn-postgres",
      "name": "Postgres URI password",
      "severity": "high",
      "category": "database",
      "regex": "(?i)postgres(?:ql)?://[^/\\s:@]+:([^/\\s:@]{3,})@",
      "keywords": [
        "postgres"
      ],
      "entropy_min": 0,
      "description": "Password in a Postgres connection URI."
    },
    {
      "id": "db-conn-mysql",
      "name": "MySQL URI password",
      "severity": "high",
      "category": "database",
      "regex": "(?i)mysql://[^/\\s:@]+:([^/\\s:@]{3,})@",
      "keywords": [
        "mysql://"
      ],
      "entropy_min": 0,
      "description": "Password in a MySQL connection URI."
    },
    {
      "id": "db-conn-redis",
      "name": "Redis URI password",
      "severity": "high",
      "category": "database",
      "regex": "(?i)rediss?://[^/\\s:@]*:([^/\\s:@]{3,})@",
      "keywords": [
        "redis://",
        "rediss://"
      ],
      "entropy_min": 0,
      "description": "Password in a Redis connection URI."
    },
    {
      "id": "jdbc-password",
      "name": "JDBC / conn-string password",
      "severity": "high",
      "category": "database",
      "regex": "(?i)(?:password|pwd)\\s*=\\s*([^;\\s\"'>]{4,});?",
      "keywords": [
        "password=",
        "pwd="
      ],
      "entropy_min": 0,
      "description": "Password in a JDBC/ADO.NET connection string."
    },
    {
      "id": "amqp-conn",
      "name": "AMQP URI password",
      "severity": "high",
      "category": "database",
      "regex": "(?i)amqps?://[^/\\s:@]+:([^/\\s:@]{3,})@",
      "keywords": [
        "amqp://",
        "amqps://"
      ],
      "entropy_min": 0,
      "description": "Password in an AMQP/RabbitMQ URI."
    },
    {
      "id": "maven-settings-password",
      "name": "Maven settings.xml password",
      "severity": "high",
      "category": "registry",
      "regex": "<password>\\s*([^<\\s]{4,})\\s*</password>",
      "keywords": [
        "<password>"
      ],
      "entropy_min": 0,
      "description": "Server password in Maven settings.xml (unless encrypted {...})."
    },
    {
      "id": "xml-key-element",
      "name": "XML key/secret element",
      "severity": "medium",
      "category": "generic",
      "regex": "(?i)<(?:apikey|api-key|secret|accesskey|access-key|token|clientsecret)>\\s*([^<\\s]{8,})\\s*</",
      "keywords": [
        "<apikey",
        "<secret",
        "<token",
        "<accesskey",
        "<clientsecret"
      ],
      "entropy_min": 3.5,
      "description": "Secret-bearing XML element."
    },
    {
      "id": "htpasswd",
      "name": ".htpasswd entry",
      "severity": "medium",
      "category": "generic",
      "regex": "(?m)^[A-Za-z0-9._\\-]+:(\\$(?:apr1|2[aby]|6|1)\\$[^\\s:]+)",
      "keywords": [
        "$apr1$",
        "$2y$",
        "$2a$",
        "$2b$",
        "$6$"
      ],
      "entropy_min": 0,
      "description": "Hashed credential in an .htpasswd file."
    },
    {
